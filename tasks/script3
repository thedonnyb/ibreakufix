## Check
# if $user does not exist, -1 otherwise +1
if id $user &>/dev/null 
then
echo "Task 3.1:Pass -- $user exists (+1)" | tee -a check.txt 
else 
echo "Task 3.1:Fail -- $user does not exist (-1)" | tee -a check.txt
fi

# if jdoe is a part of developers groups, +1 otherwise -1
if id -Gn $user | grep -qw developers &>/dev/null
then
echo "Task 3.2: Pass -- $user has been added to developers group" | tee -a check.txt
else
echo "Task 3.2: Fail -- $user was never added to developers group" | tee -a check.txt
fi.
